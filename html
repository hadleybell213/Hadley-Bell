<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hadley Bell | Agricultural Communications & Business</title>

    <style>

        /* ---------- RESET ---------- */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f7f5ef;
            color: #263a29;
        }

        /* ---------- NAVIGATION ---------- */

        header {
            background-color: #ffffff;
            width: 100%;
            border-bottom: 1px solid #dddcd4;
        }

        nav {
            max-width: 1200px;
            margin: auto;
            padding: 22px 30px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: Georgia, serif;
            font-size: 27px;
            font-weight: bold;
            color: #315238;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 30px;
        }

        nav ul li a {
            color: #35483a;
            text-decoration: none;
            font-size: 15px;
            font-weight: bold;
        }

        nav ul li a:hover {
            color: #78945b;
        }

        /* ---------- HERO ---------- */

        .hero {
            min-height: 650px;

            display: flex;
            align-items: center;

            background-color: #315238;

            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: "";
            position: absolute;

            width: 600px;
            height: 600px;

            border-radius: 50%;

            background-color: #405f45;

            right: -200px;
            top: -200px;

            opacity: 0.5;
        }

        .hero::after {
            content: "";
            position: absolute;

            width: 400px;
            height: 400px;

            border-radius: 50%;

            background-color: #6f8756;

            right: 100px;
            bottom: -250px;

            opacity: 0.35;
        }

        .hero-content {
            width: 90%;
            max-width: 1100px;
            margin: auto;

            position: relative;
            z-index: 2;

            padding: 90px 0;
        }

        .hero-small {
            color: #dce6c9;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 14px;
            font-weight: bold;

            margin-bottom: 20px;
        }

        .hero h1 {
            font-family: Georgia, serif;

            color: #ffffff;

            font-size: clamp(55px, 9vw, 100px);

            line-height: 0.95;

            margin-bottom: 30px;
        }

        .hero h1 span {
            color: #d6e2bd;
        }

        .hero-description {
            max-width: 700px;

            color: #eef2e9;

            font-size: 20px;

            line-height: 1.7;

            margin-bottom: 35px;
        }

        .buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .button {
            display: inline-block;

            padding: 15px 28px;

            border-radius: 5px;

            text-decoration: none;

            font-weight: bold;

            transition: 0.3s;
        }

        .green-button {
            background-color: #d6e2bd;
            color: #315238;
        }

        .green-button:hover {
            background-color: white;
            transform: translateY(-3px);
        }

        .clear-button {
            color: white;
            border: 2px solid white;
        }

        .clear-button:hover {
            background-color: white;
            color: #315238;
            transform: translateY(-3px);
        }

        /* ---------- GENERAL SECTIONS ---------- */

        section {
            padding: 90px 20px;
        }

        .section-container {
            max-width: 1100px;
            margin: auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-label {
            color: #78945b;

            text-transform: uppercase;

            letter-spacing: 3px;

            font-size: 13px;

            font-weight: bold;

            margin-bottom: 12px;
        }

        .section-title h2 {
            font-family: Georgia, serif;

            color: #315238;

            font-size: 42px;

            margin-bottom: 15px;
        }

        .section-title p {
            color: #687168;

            max-width: 650px;

            margin: auto;

            font-size: 17px;
        }

        /* ---------- ABOUT ---------- */

        #about {
            background-color: #f7f5ef;
        }

        .about-grid {
            display: grid;

            grid-template-columns: 1fr 1.5fr;

            gap: 70px;

            align-items: center;
        }

        .about-heading h2 {
            font-family: Georgia, serif;

            font-size: 45px;

            color: #315238;

            line-height: 1.15;
        }

        .about-text p {
            color: #5d675f;

            font-size: 17px;

            line-height: 1.8;

            margin-bottom: 20px;
        }

        .about-name {
            font-weight: bold;
            color: #315238;
        }

        /* ---------- FOCUS ---------- */

        #focus {
            background-color: #ffffff;
        }

        .focus-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 25px;
        }

        .focus-card {
            background-color: #f3f4ed;

            border: 1px solid #e1e2d8;

            padding: 40px 30px;

            border-radius: 10px;

            text-align: center;

            transition: 0.3s;
        }

        .focus-card:hover {
            transform: translateY(-7px);

            box-shadow: 0 12px 30px rgba(40, 60, 40, 0.10);
        }

        .focus-icon {
            font-size: 45px;

            margin-bottom: 20px;
        }

        .focus-card h3 {
            font-family: Georgia, serif;

            color: #315238;

            font-size: 25px;

            margin-bottom: 12px;
        }

        .focus-card p {
            color: #626c64;

            line-height: 1.7;
        }

        /* ---------- EXPERIENCE ---------- */

        #experience {
            background-color: #315238;
        }

        #experience .section-label {
            color: #d6e2bd;
        }

        #experience .section-title h2 {
            color: white;
        }

        #experience .section-title p {
            color: #dce4da;
        }

        .experience-grid {
            display: grid;

            grid-template-columns: 1fr 1fr 1fr;

            gap: 25px;
        }

        .experience-card {
            border-top: 3px solid #a1b77e;

            padding: 30px;

            background-color: #3d6043;
        }

        .experience-card h3 {
            font-family: Georgia, serif;

            color: #e0e8cf;

            font-size: 24px;

            margin-bottom: 15px;
        }

        .experience-card p {
            color: #d9e1d8;

            line-height: 1.7;
        }

        /* ---------- EDUCATION ---------- */

        #education {
            background-color: #f7f5ef;
        }

        .education-box {
            max-width: 900px;

            margin: auto;

            background-color: white;

            padding: 50px;

            border-left: 6px solid #78945b;

            box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        }

        .education-box h2 {
            font-family: Georgia, serif;

            color: #315238;

            font-size: 35px;

            margin-bottom: 8px;
        }

        .education-school {
            color: #78945b;

            font-size: 20px;

            font-weight: bold;

            margin-bottom: 20px;
        }

        .education-box p {
            color: #626b63;

            line-height: 1.7;

            margin-bottom: 12px;
        }

        /* ---------- PORTFOLIO ---------- */

        #portfolio {
            background-color: white;
        }

        .portfolio-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 25px;
        }

        .portfolio-card {
            min-height: 260px;

            padding: 30px;

            display: flex;

            flex-direction: column;

            justify-content: flex-end;

            border-radius: 10px;

            color: white;

            position: relative;

            overflow: hidden;
        }

        .portfolio-card::before {
            content: "";

            position: absolute;

            inset: 0;

            background-color: rgba(30, 55, 34, 0.55);
        }

        .portfolio-card-content {
            position: relative;

            z-index: 2;
        }

        .portfolio-card h3 {
            font-family: Georgia, serif;

            font-size: 28px;

            margin-bottom: 8px;
        }

        .portfolio-card p {
            color: #eef2eb;
        }

        .portfolio-agriculture {
            background-color: #5d7549;
        }

        .portfolio-marketing {
            background-color: #71845d;
        }

        .portfolio-communication {
            background-color: #49634c;
        }

        /* ---------- CONTACT ---------- */

        #contact {
            background-color: #e8eadf;

            text-align: center;
        }

        .contact-content {
            max-width: 750px;

            margin: auto;
        }

        .contact-content h2 {
            font-family: Georgia, serif;

            color: #315238;

            font-size: 45px;

            margin-bottom: 20px;
        }

        .contact-content p {
            color: #5f6961;

            font-size: 18px;

            line-height: 1.7;

            margin-bottom: 30px;
        }

        /* ---------- FOOTER ---------- */

        footer {
            background-color: #202e22;

            color: #cbd4ca;

            text-align: center;

            padding: 35px 20px;
        }

        footer h3 {
            font-family: Georgia, serif;

            color: white;

            font-size: 22px;

            margin-bottom: 8px;
        }

        footer p {
            font-size: 14px;
        }

        /* ---------- MOBILE ---------- */

        @media (max-width: 800px) {

            nav {
                flex-direction: column;

                gap: 18px;
            }

            nav ul {
                gap: 15px;

                flex-wrap: wrap;

                justify-content: center;
            }

            .about-grid {
                grid-template-columns: 1fr;

                gap: 30px;
            }

            .focus-grid,
            .experience-grid,
            .portfolio-grid {
                grid-template-columns: 1fr;
            }

            .about-heading h2 {
                font-size: 38px;
            }

            .section-title h2 {
                font-size: 35px;
            }

            .contact-content h2 {
                font-size: 36px;
            }

        }

        @media (max-width: 500px) {

            .hero {
                min-height: 600px;
            }

            .hero h1 {
                font-size: 55px;
            }

            .hero-description {
                font-size: 17px;
            }

            .buttons {
                flex-direction: column;
            }

            .button {
                text-align: center;

                width: 100%;
            }

            .education-box {
                padding: 30px 25px;
            }

        }

    </style>
</head>


